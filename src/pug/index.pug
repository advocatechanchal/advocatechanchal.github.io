doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Advocates Chanchal Singh and Devesh Bhati')
        meta(name='author', content='Advocates Chanchal Singh and Devesh Bhati')

        title Advocates Chanchal Singh & Devesh Bhati

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')

        // Google fonts
        link(href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        nav#mainNav.navbar.navbar-expand-lg.navbar-dark.fixed-top
            .container
                a.navbar-brand(href='#page-top') Advocates
                button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    | Menu
                    i.fas.fa-bars.ms-1
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.text-uppercase.ms-auto.py-4.py-lg-0
                        li.nav-item
                            a.nav-link(href='#practice') Practice Areas
                        li.nav-item
                            a.nav-link(href='#contact') Contact

        header.masthead
            .container
                .masthead-subheading Legal Practice
                .masthead-heading Advocate Chanchal Singh
                p.lead.masthead-brief Advocate Devesh Bhati
                a.btn.btn-primary.btn-xl.text-uppercase(href='#practice') Areas of Practice
                a.btn.btn-outline-light.btn-xl.text-uppercase.ms-lg-3.mt-3.mt-lg-0(href='#contact') Contact

        section#practice.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Areas of Practice
                    h3.section-subheading.text-muted
                .row.g-3
                    .col-md-6.col-lg-4
                        .coverage-badge Civil Litigation
                    .col-md-6.col-lg-4
                        .coverage-badge Criminal Litigation
                    .col-md-6.col-lg-4
                        .coverage-badge Probate and Succession Matters
                    .col-md-6.col-lg-4
                        .coverage-badge Property and Real Estate Disputes
                    .col-md-6.col-lg-4
                        .coverage-badge Family and Matrimonial Matters
                    .col-md-6.col-lg-4
                        .coverage-badge Banking and Recovery Matters
                    .col-md-6.col-lg-4
                        .coverage-badge Consumer Disputes
                    .col-md-6.col-lg-4
                        .coverage-badge Legal Research and Case Analysis
                    .col-md-6.col-lg-4
                        .coverage-badge Legal Drafting
                    .col-md-6.col-lg-4
                        .coverage-badge Client Counselling and Case Strategy
                    .col-md-6.col-lg-4
                        .coverage-badge Court Appearance and Litigation Support

        section#contact.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Contact
                    h3.section-subheading.text-muted
                .row.g-4.justify-content-center
                    .col-lg-5
                        .contact-detail-card
                            h4.text-uppercase Advocate Chanchal Singh
                            .detail-row
                                span.label Contact
                                span.value
                                    a.link-dark.text-decoration-none(href='tel:9873709824') 9873709824
                    .col-lg-5
                        .contact-detail-card
                            h4.text-uppercase Advocate Devesh Bhati
                            .detail-row
                                span.label Contact
                                span.value
                                    a.link-dark.text-decoration-none(href='tel:8193837323') 8193837323

        footer.footer.py-4
            .container
                .row.align-items-center
                    .col-lg-6.text-lg-start Copyright © 2026
                    .col-lg-6.text-lg-end
                        a.link-dark.text-decoration-none.me-3(href='#practice') Practice Areas
                        a.link-dark.text-decoration-none(href='#contact') Contact

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
        script(src='js/scripts.js')
