doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Law offices of Advocates Chanchal Singh and Devesh Bhati')
        meta(name='author', content='Advocates Chanchal Singh and Devesh Bhati')

        title Chanchal Singh & Devesh Bhati | Advocates

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')

        // Google fonts
        link(href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        nav#mainNav.navbar.navbar-expand-lg.navbar-dark.fixed-top
            .container
                a.navbar-brand(href='#page-top') Nyayasindhu | न्यायसिन्धु
                button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    | Menu
                    i.fas.fa-bars.ms-1
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.text-uppercase.ms-auto.py-4.py-lg-0
                        li.nav-item
                            a.nav-link(href='#practice') Practice Areas
                        li.nav-item
                            a.nav-link(href='#contact') Contact

        header.masthead
            .container
                .masthead-subheading Law Firm
                .masthead-names
                    h1.masthead-heading Advocate Chanchal Singh
                    h1.masthead-heading Advocate Devesh Bhati
                p.lead.masthead-brief
                    | Nyayasindhu provides litigation and advisory support across civil, criminal,
                    |  family, property, consumer, and revenue court matters with practical case strategy.
                a.btn.btn-primary.btn-xl.text-uppercase(href='#practice') Areas of Practice
                a.btn.btn-outline-light.btn-xl.text-uppercase.ms-lg-3.mt-3.mt-lg-0(href='#contact') Contact

        section#practice.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Areas of Practice
                    h3.section-subheading.text-muted
                        | Focused representation, drafting, and case planning for district courts,
                        |  revenue courts, and related legal forums.
                .row.g-3
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-gavel
                            h4.practice-title Civil Litigation
                            p.practice-description Civil suits, injunctions, money recovery, and procedural representation from filing to final disposal.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-handcuffs
                            h4.practice-title Criminal Litigation
                            p.practice-description Complaint drafting, bail strategy, trial-stage support, and hearing coordination in criminal matters.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-file-contract
                            h4.practice-title Probate and Succession Matters
                            p.practice-description Petitions, succession certificates, probate proceedings, and inheritance-related documentation support.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-home
                            h4.practice-title Property and Real Estate Disputes
                            p.practice-description Title concerns, possession disputes, sale agreement conflicts, and property-related legal remedies.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-ring
                            h4.practice-title Family and Matrimonial Matters
                            p.practice-description Divorce, maintenance, custody, domestic issues, and negotiated settlement assistance with sensitivity.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-university
                            h4.practice-title Banking and Recovery Matters
                            p.practice-description Recovery proceedings, borrower-lender disputes, documentation review, and strategic case response.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-exclamation-circle
                            h4.practice-title Consumer Disputes
                            p.practice-description Complaint drafting and representation for deficiency in services, refund claims, and compensation matters.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-book
                            h4.practice-title Legal Research and Case Analysis
                            p.practice-description Matter-specific research, precedent analysis, and legal issue mapping for stronger case positioning.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-pen-nib
                            h4.practice-title Legal Drafting
                            p.practice-description Plaints, written statements, petitions, applications, affidavits, legal notices, and agreements.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-leaf
                            h4.practice-title Uttar Pradesh Revenue Court and Land Laws
                            p.practice-description Advice and representation in state revenue law matters affecting agricultural and land rights.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-scale-balanced
                            h4.practice-title Revenue Court Litigation
                            p.practice-description Proceedings before revenue authorities for declaratory, title, possession, and related reliefs.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-handshake
                            h4.practice-title Land Acquisition, Rehabilitation and Resettlement (LARR) matters
                            p.practice-description Objections, compensation-related disputes, and legal support in acquisition-linked proceedings.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-map
                            h4.practice-title Mutation, Partition & Demarcation Matters
                            p.practice-description Applications, objections, and litigation support for mutation entries and boundary demarcation disputes.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-lightbulb
                            h4.practice-title Client Counselling and Case Strategy
                            p.practice-description Honest case assessment, risk analysis, and practical next steps before and during litigation.
                    .col-md-6.col-lg-4
                        .practice-card
                            .practice-icon
                                i.fas.fa-handshake
                            h4.practice-title Court Appearance and Litigation Support
                            p.practice-description Appearance support, procedural follow-up, filing coordination, and regular matter-status guidance.

        section#contact.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Contact
                    h3.section-subheading.text-muted
                        | For consultation, call directly or visit the office address below.
                .row.g-4.justify-content-center
                    .col-lg-10
                        .contact-detail-card
                            h4.text-uppercase Office Address
                            .detail-row
                                span.label Address
                                span.value Chamber Number 798, Gali Number 22, District & Sessions Court, Surajpur, Gautam Budh Nagar (UP)
                    .col-lg-5
                        .contact-detail-card
                            h4.text-uppercase Advocate Chanchal Singh
                            .detail-row
                                span.label Contact
                                span.value
                                    a.link-dark.text-decoration-none(href='tel:9873709824') 9873709824
                    .col-lg-5
                        .contact-detail-card
                            h4.text-uppercase Advocate Devesh Bhati
                            .detail-row
                                span.label Contact
                                span.value
                                    a.link-dark.text-decoration-none(href='tel:8193837323') 8193837323
                    .col-lg-10
                        .contact-detail-card
                            h4.text-uppercase Consultation Notes
                            p.mb-2 Please keep basic details ready before discussion to help with faster legal guidance.
                            ul.consultation-list
                                li Name and contact number
                                li Short matter summary and timeline
                                li Available documents or previous orders

        footer.footer.py-4
            .container
                .row.align-items-center
                    .col-lg-6.text-lg-start Copyright © 2026
                    .col-lg-6.text-lg-end
                        a.link-dark.text-decoration-none.me-3(href='#practice') Practice Areas
                        a.link-dark.text-decoration-none(href='#contact') Contact

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
        script(src='js/scripts.js')
